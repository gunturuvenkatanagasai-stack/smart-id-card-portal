# Backend Port & Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# SMTP College Email Configuration
# Note: For Gmail, use an App Password (16 characters) generated at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mic.portal.verify@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM="MIC College Student Portal" <mic.portal.verify@gmail.com>

# Database URL (Optional: If omitted, portal uses in-memory registered students store)
DATABASE_URL=
